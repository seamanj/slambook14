{
    "cmake.configureOnOpen": false,
    "files.associations": {
        "ostream": "cpp",
        "mutex": "cpp",
        "array": "cpp",
        "string": "cpp",
        "string_view": "cpp"
    },
    "C_Cpp.default.compilerPath": "D:\\Software\\msys64\\ucrt64\\bin\\g++.exe",
    "cmake.debugConfig": {
        "args": [
            "--config_file=${workspaceFolder}/config/myconfig.yaml"
        ],
        "cwd": "${workspaceFolder}/build/bin",
        "environment": [
            {
                "name": "PATH",
                "value": "${workspaceFolder}/build/lib;${env:PATH}"
            }
        ]
    }
}



// settings.json 中的 cmake.debugConfig
// 使用者：CMake Tools 扩展

